# Production environment for docker-compose.prod.yml (Option B — GCE e2-micro).
# On the VM: copy this file to infra/docker/.env and fill in REAL values.
#   cp infra/docker/.env.example infra/docker/.env
# .env is gitignored — NEVER commit real secrets. See docs/12 §7 (go-live checklist).

# --- Public hostname (needs a DNS A record pointing at the VM's external IP) ---
API_DOMAIN=api.yourdomain.com

# --- Web SPA origin allowed by CORS (your Firebase Hosting / web domain) ---
WEB_ORIGIN=https://app.yourdomain.com

# --- API container image in GHCR. deploy.yml rewrites this line to the deployed
#     git SHA on every deploy; set it to :latest for the first manual bring-up.
#     NOTE: the GitHub owner must be lowercase in GHCR paths. ---
API_IMAGE=ghcr.io/<github-owner>/erp-api:latest

# --- PostgreSQL (runs in a container on this VM; data on the persistent disk) ---
POSTGRES_DB=erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME-strong-random-db-password

# --- JWT signing key: 32+ random characters. App refuses to start if shorter
#     (docs/12 §1). Generate e.g.:  openssl rand -base64 48 ---
JWT_SIGNING_KEY=CHANGE-ME-32-or-more-random-characters
