# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
# {$API_DOMAIN} is injected from infra/docker/.env via docker-compose.prod.yml.
# Caddy provisions and renews the TLS cert automatically once the domain's
# A record points at this VM and ports 80/443 are open.

{$API_DOMAIN} {
	encode gzip

	# HSTS — the app already sets nosniff/X-Frame-Options/etc. (see docs/12 §1);
	# HTTPS enforcement + HSTS belong at the TLS edge.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	reverse_proxy api:8080 {
		health_uri /health/ready
		health_interval 30s
	}
}
